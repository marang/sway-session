# AppArmor deny-list guard for the native Codex CLI.
#
# Install with:
#   sudo install -m 0644 contrib/apparmor/codex-home-guard /etc/apparmor.d/codex-home-guard
#   sudo apparmor_parser -r /etc/apparmor.d/codex-home-guard
#
# This template and the narrow initializer assume the account's default XDG
# config/state roots. The initializer intentionally ignores caller-provided XDG
# overrides; custom roots need explicit system-level support first.

abi <abi/4.0>,
include <tunables/global>

profile codex-home-guard /usr/bin/codex flags=(attach_disconnected,mediate_deleted) {
  allow all,

  # Keep ordinary children inside the same profile. The root-owned initializer
  # has one explicit transition into the narrow child profile below.
  /** ix,
  # Capital-P transition mode scrubs unsafe loader environment variables such
  # as LD_PRELOAD before the helper gains the child profile's permissions.
  /usr/bin/sway-herdr-init Px -> sway-herdr-init,
  deny change_profile,

  # Authentication keys and credential stores.
  audit deny @{HOME}/.ssh/{,**} mrwkl,
  audit deny @{HOME}/.gnupg/{,**} mrwkl,
  audit deny @{HOME}/.aws/{,**} mrwkl,
  audit deny @{HOME}/.azure/{,**} mrwkl,
  audit deny @{HOME}/.kube/{,**} mrwkl,
  audit deny @{HOME}/.password-store/{,**} mrwkl,
  audit deny @{HOME}/.local/share/password-store/{,**} mrwkl,
  audit deny @{HOME}/.local/share/keyrings/{,**} mrwkl,
  audit deny @{HOME}/.pki/{,**} mrwkl,

  # Service and package-manager credentials.
  audit deny @{HOME}/.config/gcloud/{,**} mrwkl,
  # GitHub CLI configuration is intentionally available to Codex. Keep gh
  # authentication in the desktop keyring; file-backed tokens would no longer
  # be protected by this deny-list profile.
  audit deny @{HOME}/.config/glab-cli/{,**} mrwkl,
  audit deny @{HOME}/.config/op/{,**} mrwkl,
  audit deny @{HOME}/.config/rclone/{,**} mrwkl,
  audit deny @{HOME}/.config/containers/auth.json mrwkl,
  audit deny @{HOME}/.docker/config.json mrwkl,
  audit deny @{HOME}/.netrc mrwkl,
  audit deny @{HOME}/.git-credentials mrwkl,
  audit deny @{HOME}/.npmrc mrwkl,
  audit deny @{HOME}/.pypirc mrwkl,
  audit deny @{HOME}/.pgpass mrwkl,
  audit deny @{HOME}/.my.cnf mrwkl,
  audit deny @{HOME}/.authinfo{,.gpg} mrwkl,

  # Shell and REPL histories commonly contain pasted secrets.
  audit deny @{HOME}/.*history mrwkl,
  audit deny @{HOME}/.local/share/fish/fish_history mrwkl,

  # Browser profiles contain sessions, cookies, and saved credentials.
  audit deny @{HOME}/.mozilla/{,**} mrwkl,
  audit deny @{HOME}/.config/chromium/{,**} mrwkl,
  audit deny @{HOME}/.config/google-chrome{,-beta,-dev}/{,**} mrwkl,
  audit deny @{HOME}/.config/BraveSoftware/{,**} mrwkl,

  # GnuPG and desktop keyrings remain private. The dedicated SSH agent is
  # intentionally available so Git can authenticate without reading .ssh.
  audit deny @{run}user/[0-9]*/gnupg/{,**} mrwkl,
  audit deny @{run}user/[0-9]*/keyring/{,**} mrwkl,

  # Protect the pathname entries for container APIs which could ask an
  # unconfined service to expose protected paths. On kernels which do not
  # mediate pathname socket connect(2) through file rules, this deny-list does
  # not prevent the connection itself; that accepted gap is tracked in LAB-89.
  audit deny @{run}user/[0-9]*/podman/podman.sock mrwkl,
  audit deny @{run}user/[0-9]*/docker.sock mrwkl,
  audit deny /run/docker.sock mrwkl,
  audit deny /var/run/docker.sock mrwkl,

  # Persistent terminal history, outer-session registry/layout, approved
  # desktop launchers, and the per-compositor application attempt journal stay
  # outside Codex. The same file rules protect Herdr socket pathnames, but do
  # not claim to mediate pathname socket connect(2) on every supported kernel.
  audit deny @{HOME}/.config/herdr/{,**} mrwkl,
  audit deny @{HOME}/.local/state/sway-session/{,**} mrwkl,

  # Protect the Sway socket pathname. Direct Sway IPC can execute commands
  # through the unconfined compositor, but pathname connect mediation is a
  # known LAB-89 gap in this deny-list design.
  audit deny @{run}user/[0-9]*/sway-ipc.*.sock mrwkl,

  # The intended session integration endpoints are owned by the independent
  # sway-session daemon. They accept fixed, schema-validated operations and
  # return no raw registry contents. The title animator hosts neither endpoint.
  # Pathname mutation protections do not turn this broad deny-list into a
  # complete socket-connect boundary; see the experimental status in README.
  audit deny @{run}user/[0-9]*/sway-session wkl,
  audit deny @{run}user/[0-9]*/sway-session/ wkl,
  audit deny @{run}user/[0-9]*/sway-session/app-operations/{,**} mrwkl,
  audit deny @{run}user/[0-9]*/sway-session/codex-report.sock klm,
  owner @{run}user/[0-9]*/sway-session/codex-report.sock rw,

  # The context-start endpoint accepts only typed context metadata and a
  # numbered empty workspace. It does not accept pane roles or commands.
  audit deny @{run}user/[0-9]*/sway-session/session-start.sock klm,
  owner @{run}user/[0-9]*/sway-session/session-start.sock rw,
}

# This profile is reachable only by executing the packaged, root-owned helper.
# The helper loads one exact active context, calls Herdr with fixed argv, and
# refuses to mutate any Herdr session which is not genuinely empty.
profile sway-herdr-init /usr/bin/sway-herdr-init flags=(attach_disconnected,mediate_deleted) {
  allow all,
  /** ix,
  deny change_profile,

  # Retain the high-value credential boundary while the fixed Herdr client is
  # running. Herdr state itself is intentionally available in this child.
  audit deny @{HOME}/.ssh/{,**} mrwkl,
  audit deny @{HOME}/.gnupg/{,**} mrwkl,
  audit deny @{HOME}/.aws/{,**} mrwkl,
  audit deny @{HOME}/.azure/{,**} mrwkl,
  audit deny @{HOME}/.kube/{,**} mrwkl,
  audit deny @{HOME}/.password-store/{,**} mrwkl,
  audit deny @{HOME}/.local/share/password-store/{,**} mrwkl,
  audit deny @{HOME}/.local/share/keyrings/{,**} mrwkl,
  audit deny @{HOME}/.pki/{,**} mrwkl,
  audit deny @{HOME}/.config/gcloud/{,**} mrwkl,
  audit deny @{HOME}/.config/gh/{,**} mrwkl,
  audit deny @{HOME}/.config/glab-cli/{,**} mrwkl,
  audit deny @{HOME}/.config/op/{,**} mrwkl,
  audit deny @{HOME}/.config/rclone/{,**} mrwkl,
  audit deny @{HOME}/.config/containers/auth.json mrwkl,
  audit deny @{HOME}/.docker/config.json mrwkl,
  audit deny @{HOME}/.netrc mrwkl,
  audit deny @{HOME}/.git-credentials mrwkl,
  audit deny @{HOME}/.npmrc mrwkl,
  audit deny @{HOME}/.pypirc mrwkl,
  audit deny @{HOME}/.pgpass mrwkl,
  audit deny @{HOME}/.my.cnf mrwkl,
  audit deny @{HOME}/.authinfo{,.gpg} mrwkl,
  audit deny @{HOME}/.*history mrwkl,
  audit deny @{HOME}/.local/share/fish/fish_history mrwkl,
  audit deny @{HOME}/.mozilla/{,**} mrwkl,
  audit deny @{HOME}/.config/chromium/{,**} mrwkl,
  audit deny @{HOME}/.config/google-chrome{,-beta,-dev}/{,**} mrwkl,
  audit deny @{HOME}/.config/BraveSoftware/{,**} mrwkl,
  audit deny @{run}user/[0-9]*/gnupg/{,**} mrwkl,
  audit deny @{run}user/[0-9]*/keyring/{,**} mrwkl,
  audit deny @{run}user/[0-9]*/podman/podman.sock mrwkl,
  audit deny @{run}user/[0-9]*/docker.sock mrwkl,
  audit deny /run/docker.sock mrwkl,
  audit deny /var/run/docker.sock mrwkl,
  audit deny @{run}user/[0-9]*/sway-ipc.*.sock mrwkl,

  # Registry files are inputs, never mutation targets for the initializer. The
  # directory itself retains w+k because Linux reports both permissions for
  # the exclusive flock which serializes inspection with archive and purge.
  audit deny @{HOME}/.local/state/sway-session/** wl,
}
